    {"type": "face", "actor": "icaro", "to": "sobrevivente_1"},
    {"type": "face", "actor": "tonho", "to": "sobrevivente_1"},
    {"type": "say", "speaker": "sobrevivente_1", "portrait": "aldeao_medo", "text": "Não vai pra lá, menino! São os focinhos-de-brasa!"},
    {"type": "say", "speaker": "icaro", "portrait": "icaro_medo", "text": "Os o quê?"},
    {"type": "say", "speaker": "sobrevivente_1", "portrait": "aldeao_medo", "text": "Os Caligosuins! Saíram do nada, cuspindo fogo preto! Tá tudo queimando!"},
    {"type": "say", "speaker": "sobrevivente_2", "portrait": "aldea_medo", "text": "Os soldados da capital tão juntando gente no bambuzal, atrás do morro. Vem com a gente!"},
    {"type": "face", "actor": "tonho", "to": "icaro"},
    {"type": "face", "actor": "icaro", "to": "tonho"},
    {"type": "say", "speaker": "tonho", "portrait": "tonho_medo", "text": "Minha casa é na beira do pasto, fora da vila. Eu pego a Nina e subo pro bambuzal."},
    {"type": "say", "speaker": "tonho", "portrait": "tonho_medo", "text": "Ícaro... vem comigo. Entrar na vila é loucura."},
    {"type": "say", "speaker": "icaro", "portrait": "icaro_determinado", "text": "Meu pai mal anda com aquelas costas, Tonho. Ele não sai de lá sozinho."},
    {"type": "say", "speaker": "tonho", "portrait": "tonho_neutro", "text": "...Então vai rápido e volta inteiro. Você me deve um terço de dezoito quilos."},
    {"type": "say", "speaker": "icaro", "portrait": "icaro_determinado", "text": "Te vejo no bambuzal."},
    {"type": "move", "actor": "tonho", "to": "marcador_estrada_saida_pasto", "speed": "run", "wait": false},
    {"type": "move", "actor": "sobrevivente_1", "to": "marcador_estrada_inicio", "speed": "run", "wait": false},
    {"type": "move", "actor": "sobrevivente_2", "to": "marcador_estrada_inicio", "speed": "run"},
    {"type": "despawn", "actor": "tonho"},
    {"type": "despawn", "actor": "sobrevivente_1"},
    {"type": "despawn", "actor": "sobrevivente_2"},
