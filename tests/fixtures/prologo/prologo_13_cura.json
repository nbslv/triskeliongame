{
  "id": "prologo_13_cura",
  "steps": [
    {"type": "say", "speaker": "icaro", "portrait": "icaro_determinado", "text": "Não fala mais. Guarda o fôlego. Eu sei uma magia."},
    {"type": "say", "speaker": "pai", "portrait": "pai_ferido", "text": "Ícaro..."},
    {"type": "say", "speaker": "icaro", "portrait": "icaro_determinado", "text": "'Alento'. Capítulo três. Eu treinei, pai. Eu treinei toda noite."},
    {"type": "anim", "actor": "icaro", "anim": "conjurar"},
    {"type": "say", "speaker": "icaro", "portrait": "icaro_medo", "text": "Calma, respiração firme, mãos quentes. Calma, respiração firme, mãos quentes..."},
    {"type": "say", "speaker": "tutorial", "text": "Escolha como Ícaro tenta conjurar a magia."},
    {"type": "choice", "options": [{"text": "Respirar fundo e conjurar", "goto": "t1"}, {"text": "Lembrar das palavras do livro", "goto": "t1"}]},
    {"type": "label", "name": "t1"},
    {"type": "sfx", "id": "magia_brilho_fraco"},
    {"type": "anim", "actor": "icaro", "anim": "conjurar_brilho"},
    {"type": "wait", "ms": 900},
    {"type": "sfx", "id": "magia_falha"},
    {"type": "anim", "actor": "icaro", "anim": "conjurar"},
    {"type": "say", "speaker": "narrador", "text": "Uma luz morna acendeu entre as mãos de Ícaro... tremeu... e apagou."},
    {"type": "say", "speaker": "icaro", "portrait": "icaro_medo", "text": "De novo. Vai. De novo."},
    {"type": "choice", "options": [{"text": "Tentar com mais força", "goto": "t2"}, {"text": "Tentar mais devagar", "goto": "t2"}]},
    {"type": "label", "name": "t2"},
    {"type": "sfx", "id": "magia_brilho_fraco"},
    {"type": "anim", "actor": "icaro", "anim": "conjurar_brilho"},
    {"type": "sfx", "id": "brilho_colar"},
    {"type": "anim", "actor": "caixa_costura", "anim": "piscar"},
    {"type": "wait", "ms": 700},
    {"type": "sfx", "id": "magia_falha"},
    {"type": "anim", "actor": "icaro", "anim": "conjurar"},
    {"type": "say", "speaker": "narrador", "text": "A luz voltou, mais fraca. Dentro da caixinha de costura, alguma coisa piscou junto. Ninguém viu."},
    {"type": "say", "speaker": "icaro", "portrait": "icaro_choro", "text": "Minhas mãos não param de tremer..."},
    {"type": "choice", "options": [{"text": "Por favor...", "goto": "t3"}]},
    {"type": "label", "name": "t3"},
    {"type": "sfx", "id": "magia_falha"},
    {"type": "anim", "actor": "icaro", "anim": "ajoelhar"},
    {"type": "say", "speaker": "icaro", "portrait": "icaro_choro", "text": "Eu li esse capítulo vinte vezes! Vinte! Por que não funciona?!"},
    {"type": "say", "speaker": "icaro", "portrait": "icaro_choro", "text": "Calma, respiração firme... eu não consigo, pai, eu não consigo respirar..."},
    {"type": "say", "speaker": "pai", "portrait": "pai_sorriso_fraco", "text": "Ei. Ei. Olha pra mim."},
    {"type": "say", "speaker": "pai", "portrait": "pai_sorriso_fraco", "text": "Tá tudo bem. Não é culpa sua. Ninguém acende lampião no meio da ventania."},
    {"type": "music", "id": "tema_tensao", "fade": 600},
    {"type": "sfx", "id": "cali_grunhidos_longe"},
    {"type": "camera", "to": "marcador_vila_rua_de_cima", "ms": 1200},
    {"type": "spawn", "actor": "cali_4", "at": "marcador_vila_rua_de_cima", "dir": "down"},
    {"type": "spawn", "actor": "cali_5", "at": "marcador_vila_rua_de_cima_b", "dir": "down"},
    {"type": "spawn", "actor": "toucim", "at": "marcador_vila_rua_de_cima_c", "dir": "down"},
    {"type": "wait", "ms": 900},
    {"type": "camera", "to": "marcador_casa_pai", "ms": 900},
    {"type": "say", "speaker": "pai", "portrait": "pai_ferido", "text": "...Eles tão descendo a rua."},
    {"type": "anim", "actor": "pai", "anim": "empurrar"},
    {"type": "sfx", "id": "empurrao"},
    {"type": "move", "actor": "icaro", "to": "marcador_casa_empurrado"},
    {"type": "shake", "ms": 150},
    {"type": "say", "speaker": "pai", "portrait": "pai_ferido", "text": "Escuta bem. Você vai pra capital. Ela tá resistindo, os soldados tão recolhendo gente."},
    {"type": "say", "speaker": "icaro", "portrait": "icaro_choro", "text": "Eu não vou sem o senhor!"},
    {"type": "flag", "set": "prologo.tentou_cura"},
    {"type": "end"}
  ]
}
